{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcticfox Config",
  "version": "1.11.10",
  "identifier": "org.hobbyquaker.arcticfox-config",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Arcticfox Config",
        "width": 536,
        "height": 596,
        "minWidth": 536,
        "minHeight": 596,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/default.afc.json": "default.afc.json",
      "../public/i18n": "i18n"
    }
  }
}
