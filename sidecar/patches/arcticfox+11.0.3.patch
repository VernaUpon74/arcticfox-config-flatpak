# DEVIATION: Patch against the arcticfox npm module used by the Tauri sidecar.
# Changes from upstream:
#   1. Use instance property this.message so multiple configuration reads do not
#      leak stale bytes from previous transfers.
#   2. Parse and write the IsCelcius profile flag at bit 0x20, which the original
#      module ignored; this matches newer ArcticFox firmware behavior.
#   3. Match HID disconnect errors by prefix instead of exact string, because
#      node-hid 2.x appends platform-specific details (e.g. "unexpected poll
#      error (device disconnected)") to the base message.
#   4. Enumerate HID devices fresh on each connect() and open by device path,
#      avoiding stale cached enumerations that miss devices plugged in after
#      the sidecar process started.
diff --git a/node_modules/arcticfox/index.js b/node_modules/arcticfox/index.js
index 9363c3c..6bb8514 100644
--- a/node_modules/arcticfox/index.js
+++ b/node_modules/arcticfox/index.js
@@ -95,8 +95,16 @@ class ArcticFox extends events.EventEmitter {
 
     connect() {
         try {
-            this.hid = new HID.HID(this.vendorId, this.productId);
-            let message = Buffer.from([]);
+            // DEVIATION: Enumerate devices fresh and open by path. Opening by
+            // vendor/product ID can use a stale cached enumeration and fail to
+            // detect a device that was plugged in after the sidecar started.
+            const devices = HID.devices();
+            const device = devices.find(d => d.vendorId === this.vendorId && d.productId === this.productId);
+            if (!device) {
+                throw new Error('device not found');
+            }
+            this.hid = new HID.HID(device.path);
+            this.message = Buffer.from([]);
             this.hid.on('data', data => {
                 clearTimeout(this.timeout);
                 switch (this.expectedAnswer) {
@@ -108,9 +116,9 @@ class ArcticFox extends events.EventEmitter {
                         break;
